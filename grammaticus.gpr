with "config/grammaticus_config.gpr";
project Grammaticus is

   for Library_Name use "Grammaticus";
   for Library_Version use Project'Library_Name & ".so." & Grammaticus_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Grammaticus_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("GRAMMATICUS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      --  Disable -gnayO as a workaround for a style warning that gets emitted
      --  from SPARKlib's functional vectors package, which is outside of our
      --  control.
      for Default_Switches ("Ada") use
        Grammaticus_Config.Ada_Compiler_Switches & ("-gnaty-O");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Grammaticus;
